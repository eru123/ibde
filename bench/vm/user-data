#cloud-config
# Two-phase bench (run-bench.sh boots the VM twice):
#   boot 1 (provision): this config applies, then powers off
#   boot 2 (measure): autologin starts labwc+waybar on a prepared machine
hostname: ibde-bench
manage_etc_hosts: true
ssh_pwauth: true
ssh_authorized_keys:
  - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIL5HeJYwCWJiVs+F+qbn0d4Fdv7mVHGHX12E2eVViJqJ ibde-bench
chpasswd:
  expire: false
  users:
    - name: debian
      password: ibdebench
      type: text
packages:
  - labwc
  - waybar
  - seatd
  - grim
  - libcairo2
  - libpangocairo-1.0-0
  - libxkbcommon0
write_files:
  - path: /usr/local/bin/ibde-bench-session
    permissions: "0755"
    content: |
      #!/bin/sh
      # Started from .profile on the serial console autologin (measure boot).
      export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
      export WLR_RENDERER=pixman
      export XKB_DEFAULT_LAYOUT=us
      export LIBSEAT_BACKEND=seatd
      for i in $(seq 1 30); do [ -S /run/seatd.sock ] && break; sleep 1; done
      exec labwc -s /usr/local/bin/ibde-bench-measure
  - path: /usr/local/bin/ibde-bench-measure
    permissions: "0755"
    content: |
      #!/bin/sh
      # labwc -s runs this; stdout/stderr land on the serial tty.
      # When the seed server carries the IBDE binaries (host: cp
      # target/release/{ibde-shell,ibde-terminal} bench/vm/), run the
      # real IBDE session instead of waybar (whose floor baseline is
      # preserved in docs/bench/BASELINE.md).
      RUN_IBDE=0
      if wget -q -O /tmp/ibde-shell http://10.0.2.2:8123/ibde-shell \
         && wget -q -O /tmp/ibde-terminal http://10.0.2.2:8123/ibde-terminal; then
        chmod +x /tmp/ibde-shell /tmp/ibde-terminal
        RUN_IBDE=1
      fi
      if [ "$RUN_IBDE" = 1 ]; then
        IBDE_TERMINAL_CMD=/tmp/ibde-terminal /tmp/ibde-shell --seconds 34 >/tmp/shell.log 2>&1 &
        /tmp/ibde-terminal --exec "printf FLOOR-SESSION-OK; echo; cat" \
          --seconds 30 --cols 60 --rows 12 >/tmp/term.log 2>&1 &
      else
        waybar &
      fi
      sleep 15
      echo "=== ibde-bench baseline ==="
      date
      echo "--- free -m ---"
      free -m
      echo "--- per-process RSS KiB (top 30) ---"
      ps -eo rss,comm --sort=-rss --no-headers | head -30
      echo "--- PSS KiB (smaps_rollup, top 20) ---"
      for p in /proc/[0-9]*; do
        comm=$(cat "$p/comm" 2>/dev/null) || continue
        pss=$(awk '/^Pss:/ {print $2}' "$p/smaps_rollup" 2>/dev/null) || continue
        [ -n "$pss" ] && echo "$pss $comm"
      done | sort -rn | head -20
      echo "--- shell.log ---"; tail -2 /tmp/shell.log 2>/dev/null
      echo "--- term.log ---"; tail -2 /tmp/term.log 2>/dev/null
      echo "--- session process count ---"
      ps -e --no-headers | wc -l
      echo "=== end ==="
      if [ "$RUN_IBDE" = 1 ]; then
        sleep 2
        if grim $HOME/shot.png 2>/tmp/grim.err; then
          echo "=== LABWC-SHOT-BEGIN ==="
          base64 -w0 $HOME/shot.png
          echo
          echo "=== LABWC-SHOT-END ==="
        else
          echo "LABWC-SHOT-FAILED"
          echo "--- grim.err ---"; cat /tmp/grim.err
        fi
        wait
      fi
      sleep 1
      sudo -n poweroff
runcmd:
  # Debian's seatd grants seat access via the video group (there is no
  # 'seatd' group); DRM nodes are video-group too.
  - usermod -aG video debian
  - systemctl disable --now unattended-upgrades || true
  - systemctl enable --now seatd
  - mkdir -p /etc/systemd/system/serial-getty@ttyS0.service.d
  - |
    printf '[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin debian 115200 ttyS0 xterm\n' > /etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf
  - systemctl daemon-reload
  - |
    grep -q ibde-bench-session /home/debian/.profile || printf 'if [ "$(tty 2>/dev/null)" = "/dev/ttyS0" ] && [ -z "$IBDE_BENCH" ]; then\n  IBDE_BENCH=1; export IBDE_BENCH\n  /usr/local/bin/ibde-bench-session\n  # labwc exited (crash or end): never hang the runner\n  sleep 5\n  sudo -n poweroff\nfi\n' >> /home/debian/.profile
  # provision done — power off; the measure boot starts clean
  - sleep 2
  - poweroff
